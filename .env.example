# Copie este arquivo para .env e preencha com as suas credenciais do
# WHOOP Developer Dashboard (https://developer-dashboard.whoop.com).
# O arquivo .env está no .gitignore e nunca deve ser commitado.

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Precisa ser idêntico ao Redirect URL registrado no app do WHOOP.
WHOOP_REDIRECT_URI=https://localhost:8080/callback
